# Скопируйте в .env и поправьте значения.

# SQLite: путь относительно prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Публичный адрес сайта — из него строятся QR-коды и ссылки (никакого localhost в QR).
# Локально для телефона в той же Wi-Fi сети укажите IP ноутбука, на Render — адрес сервиса.
# NEXT_PUBLIC_* встраивается при сборке: на Render задайте переменную ДО build.
NEXT_PUBLIC_BASE_URL="http://192.168.1.10:3000"

# Секрет подписи cookie сессии организатора (длинная случайная строка). В production обязателен,
# в dev без него используется встроенный небезопасный секрет. Смена секрета разлогинивает всех.
SESSION_SECRET="change-me-to-another-long-random-string"

# Соль для анонимного хэша гостя в экспорте в рейтинг (длинная случайная строка)
EXPORT_SALT="change-me-to-a-long-random-string"
